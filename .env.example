# ═══════════════════════════════════════════════════════
#  AI Test Generator — Ortam Değişkenleri
#  Kullanım: cp .env.example .env  →  docker compose up -d
# ═══════════════════════════════════════════════════════

# ── LLM Provider ───────────────────────────────────────
# "ollama"  → yerel, ücretsiz, key gerekmez (DEFAULT)
# "openai"  → GPT-4, OPENAI_API_KEY gerekir
LLM_PROVIDER=ollama

# Ollama model — ilk çalıştırmada otomatik indirilir (~4GB)
OLLAMA_MODEL=qwen2.5-coder:1.5b

# OpenAI (LLM_PROVIDER=openai yaparsanız doldurun)
OPENAI_API_KEY=sk-...

# ── Email Bildirimleri ─────────────────────────────────
# Test sonrası email gönderilsin mi?
EMAIL_NOTIFICATIONS_ENABLED=true

# Email alıcıları (virgülle ayır)
EMAIL_RECIPIENTS=sen@sirket.com,takim@sirket.com

# Gerçek SMTP kullanmak istersen:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=gonderici@gmail.com
# MAIL_PASSWORD=uygulama-sifresi
# Yoksa MailHog (varsayılan) localhost:8025'te gösterir

# ── Allure Rapor URL ───────────────────────────────────
ALLURE_REPORT_URL=http://localhost:8888
