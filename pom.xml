<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.testgen</groupId>
    <artifactId>ai-test-generator</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>AI Test Case Generator</name>
    <description>LLM-powered test case generator – Karate, Selenium, Appium, Allure, Ollama</description>

    <properties>
        <java.version>17</java.version>

        <!-- JaCoCo prepare-agent bunu koşum anında doldurur; buradaki boş değer yalnızca
             agent koşmadığı senaryolarda @{argLine} çözümlemesinin patlamamasını sağlar. -->
        <argLine></argLine>

        <!-- Kapsam alt sınırı. Regresyon kilidi: bu eşiğin altına düşen build KIRILIR.
             Test kapsamı arttıkça kademeli yükseltilir. -->
        <!--
            Ölçülen değerler (dışlamalar sonrası): satır yaklaşık %77, dal %62.
            Eşikler bunun hemen ALTINA konur — amaç mevcut seviyeyi kilitlemek ve
            regresyonu kırmak; tam ölçüme eşitlemek, ilgisiz bir refaktörde tek satırlık
            dalgalanmayı bile build hatasına çevirip kapıyı gürültü kaynağı yapardı.
            Kapsam arttıkça bu değerler yükseltilir.
        -->
        <jacoco.line.coverage.min>0.75</jacoco.line.coverage.min>
        <jacoco.branch.coverage.min>0.60</jacoco.branch.coverage.min>

        <!-- Canlı internete bağlı testler deterministik kalite kapısının parçası değildir.
             -Pexternal-tests profili bu dışlamayı kaldırıp onları açıkça çalıştırır. -->
        <test.excluded.groups>external</test.excluded.groups>

        <!-- ── Karate: groupId io.karatelabs for modern JDK compatibility ── -->
        <karate.version>1.5.2</karate.version>

        <!-- ── LangChain4J 0.34.0 (Ollama Tool Calling Desteği İçin) ── -->
        <langchain4j.version>0.34.0</langchain4j.version>

        <!-- ── Selenium ── -->
        <selenium.version>4.18.1</selenium.version>

        <!-- ── Allure: allure-selenide 2.27.0 yok, 2.24.0 tüm modüllerde mevcut ── -->
        <allure.version>2.24.0</allure.version>
        <aspectj.version>1.9.21</aspectj.version>

        <springdoc.version>2.8.5</springdoc.version>
        <lombok.version>1.18.38</lombok.version>
        <antlr4.version>4.13.0</antlr4.version>
        <cucumber.version>7.15.0</cucumber.version>
    </properties>

    <!-- ── Allure BOM — tüm allure modüllerinin versiyonlarını yönetir ── -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!-- ════ Spring Boot ════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ════ Database ════ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Şema değişiklikleri Hibernate'in best-effort update mekanizmasından
             bağımsız, sürümlü ve denetlenebilir olarak uygulanır. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- ════ API Docs / Swagger UI ════ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ════ LangChain4J (Ollama + OpenAI) ════ -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- ════ Karate DSL ════ -->
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-core</artifactId>
            <version>${karate.version}</version>
        </dependency>
        <dependency>
            <groupId>io.karatelabs</groupId>
            <artifactId>karate-junit5</artifactId>
            <version>${karate.version}</version>
        </dependency>

        <!-- ════ Selenium ════ -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.bonigarcia</groupId>
            <artifactId>webdrivermanager</artifactId>
            <version>5.8.0</version>
        </dependency>



        <!-- ════ REST Assured ════ -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.4.0</version>
        </dependency>

        <!-- ════ OpenAPI / Swagger Parser ════ -->
        <dependency>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser</artifactId>
            <version>2.1.21</version>
        </dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4.version}</version>
        </dependency>

        <!-- ════ Cucumber BDD ════ -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-junit-platform-engine</artifactId>
            <version>${cucumber.version}</version>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-spring</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ════ Lombok / Jackson ════ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <!-- ════ Prometheus Metrics ════ -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ════ Allure (BOM ile yönetilir, version belirtme) ════ -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-rest-assured</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-selenide</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-java-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-cucumber7-jvm</artifactId>
        </dependency>

        <!-- ════ Thymeleaf layout dialect ════ -->
        <dependency>
            <groupId>nz.net.ultraq.thymeleaf</groupId>
            <artifactId>thymeleaf-layout-dialect</artifactId>
        </dependency>

        <!-- ════ AspectJ (Allure agent) ════ -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
        </dependency>

        <!-- ════ Test ════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Projenin desteklenen çalışma/derleme JDK'sı yalnız Java 17'dir.
                 source/target tek başına Maven'in Java 26 ile çalışmasını engellemez. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-java-17</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,18)</version>
                                    <message>Bu proje yalnız Java 17 ile derlenir ve test edilir. JAVA_HOME değerini JDK 17 olarak ayarlayın.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <!--
                        @{argLine} ZORUNLU: JaCoCo prepare-agent, java agent parametresini
                        "argLine" property'sine yazar. Buradaki argLine sabit yazıldığında o
                        property EZİLİYOR, agent hiç yüklenmiyor ve target/jacoco.exec HİÇ
                        üretilmiyordu — yani kapsam raporu sessizce boş kalıyordu.
                        @{...} geç değerlendirme sözdizimi; property'yi koşum anında araya alır.
                        properties bloğundaki boş <argLine/> ise, prepare-agent koşmadan
                        surefire tek başına çağrıldığında (mvn surefire:test) çözümlemenin
                        patlamaması için varsayılan sağlar.
                    -->
                    <argLine>
                        @{argLine}
                        -Dallure.results.directory=${project.build.directory}/allure-results
                        -Dorg.aspectj.weaver.Dump.exception=false
                        -Dorg.aspectj.weaver.Dump.at.abort=false
                    </argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                    </systemPropertyVariables>
                    <excludedGroups>${test.excluded.groups}</excludedGroups>
                </configuration>
            </plugin>

            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.12.0</version>
                <configuration>
                    <reportVersion>${allure.version}</reportVersion>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportDirectory>${project.build.directory}/allure-report</reportDirectory>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!--
                        Kalite kapısı: rapor üretmek tek başına yetmez — kimse bakmazsa
                        kapsam sessizce düşer. check goal'ü eşiğin altına inen build'i kırar.
                        Eşikler properties bloğunda; kapsam arttıkça yükseltilir.
                    -->
                    <execution>
                        <id>check-coverage</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.coverage.min}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.branch.coverage.min}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Faz 1 framework sağlamlaştırması: kapsamı %90'a ulaşan
                                     çekirdek bileşen tekrar bu seviyenin altına düşemez. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes>
                                        <include>com.testgen.generator.RestAssuredTestGenerator</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Agent mimarisi için ayrı regresyon kapısı: registry,
                                     routing, tool sınırı ve LLM agent sözleşmeleri. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.testgen.agent</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                                <!-- Yeni orchestration çekirdeği, framework veya provider
                                     bağımlılığı eklemeden kapalı plan sözleşmesini korur. -->
                                <rule>
                                    <element>PACKAGE</element>
                                    <includes>
                                        <include>com.testgen.orchestration</include>
                                    </includes>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <!-- Veri taşıyıcıları ve Spring giriş noktası: davranış içermez,
                                     kapsam yüzdesini yapay şişirir/düşürür. -->
                                <exclude>com/testgen/AiTestGeneratorApplication.class</exclude>
                                <exclude>com/testgen/model/**</exclude>
                                <exclude>com/testgen/**/*Dto.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>external-tests</id>
            <properties>
                <test.excluded.groups></test.excluded.groups>
            </properties>
            <build>
                <plugins>
                    <!-- Canlı test ölçümü ana suite'in jacoco.exec dosyasını ezmez. -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-external.exec</destFile>
                            <dataFile>${project.build.directory}/jacoco-external.exec</dataFile>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
